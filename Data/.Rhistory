country_mapping <- tribble(
~old_code, ~iso_2,
"GB", "GB", "SCO", "GB", "CAN", "CA", "DK", "DK", "IRL", "IE",
"NL", "NL", "USA", "US", "D", "DE", "F", "FR", "S", "SE",
"Vestindien", "VI", "CZ", "CZ", "SK", "SK", "FR", "FR", "DA", "DK",
"H", "HU", "AUS", "AU", "MEX", "MX", "N", "NO", "A", "AT",
"I", "IT", "UK", "GB", "BE", "BE", "CH", "CH", "TR", "TR",
"E", "ES", "RCH", "CL", "SF", "FI", "GH", "GH", "RA", "AR",
"DDR", "DE", "NIC", "NI", "HUN", "HU", "ZW", "ZW", "TZ", "TZ",
"KE", "KE", "NIRL", "GB", "RB", "BW", "INT", NA_character_, "AUT", "AT",
"NZ", "NZ", "BG", "BG", "ENG", "GB", "AT", "AT", "EC", "EC",
"P", "PT", "FI", "FI", "FO", "FO", "NO", "NO", "SE", "SE",
"GL", "GL", "EST", "EE", "GRL", "GL", "ZA", "ZA", "WAL", "GB",
"IT", "IT", "EN", "GB", "PL", "PL", "EAU", "UG", "GRN", "GD",
"EUS", "ES"
)
# 2. Update Tonder_grouped with the new ISO-ALPHA-2 codes
Tonder_by_nationality_clean <- Tonder_by_nationality %>%
# Join our lookup table
left_join(country_mapping, by = c("Nationalitet" = "old_code")) %>%
# Replace the old column with the new ISO codes
mutate(Nationalitet = iso_2) %>%
# Drop the extra lookup column
select(-iso_2) %>%
# Remove rows that evaluated to NA (like "INT") if you don't want them plotted
drop_na(Nationalitet)
Tonder_by_nationality <- Tonder_merged %>%
group_by(Nationalitet) %>%
tally()
Tonder_by_nationality <- Tonder_merged %>%
group_by(Nationalitet) %>%
tally()
