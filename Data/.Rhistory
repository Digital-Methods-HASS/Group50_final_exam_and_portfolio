library(tidyverse)
library(tidyverse)
library(readr)
library(gganimate)
library(gifski)
library(av)
theme_set(theme_bw())  # set theme to white background for better visibility
#Import the dataset, that we have refined in OpenRefine and Excel
Tonder_fest <- read_csv("Tonder_festival_nationaliteter_OpenRefine_4.csv") %>%
select(Navn, Nationalitet, År) %>%
drop_na(Nationalitet)
head(Tonder_fest)
# Make a list of all nationalities
Tonder_fest %>%
select(Nationalitet) %>%
unique()-> All_nations
All_nations
# Creating CSV of all nations in order to create an index
# and categorize the countries into regions
write.csv(All_nations)
# We exported the csv into excel
# Then we created an index of nations and regions in excel
# Import csv of nations sorted into regions
Tonderfest_regions <- read_csv2("Tonder_festival_region.csv") %>%
select(-Index)
glimpse(Tonderfest_regions)
# Remove index column
# Merge the region column onto the Tonder_fest2 tibble
Tonder_merged <- merge(Tonder_fest, Tonderfest_regions, by.x = "Nationalitet") %>%
arrange(År)
head(Tonder_merged)
# group by nationality, year and region
Tonder_grouped <- Tonder_merged %>%
group_by(Nationalitet,År,All_Regions) %>%
tally() %>%
arrange(År,All_Regions)
Tonder_grouped1 <- Tonder_merged %>%
group_by(Nationalitet, År, Atlantic_Nordic) %>%
tally() %>%
arrange(År, Atlantic_Nordic)
Tonder_grouped2 <- Tonder_merged %>%
group_by(Nationalitet, År, Atlantic_Other) %>%
tally() %>%
arrange(År, Atlantic_Other)
#view
head(Tonder_grouped)
long_lat <- read_csv("longitude_latitude.csv")
long_lat <- long_lat %>%
select(Country,`ISO-ALPHA-3`,`ISO-ALPHA-2`,IOC, FIFA, Latitude, Longitude)
colnames(long_lat)[3] <- "Nationalitet"
# Google AI written code:
# 1. Create a mapping dictionary for your nationalities
country_mapping <- tribble(
~old_code, ~iso_2,
"GB", "GB", "SCO", "GB", "CAN", "CA", "DK", "DK", "IRL", "IE",
"NL", "NL", "USA", "US", "D", "DE", "F", "FR", "S", "SE",
"Vestindien", "VI", "CZ", "CZ", "SK", "SK", "FR", "FR", "DA", "DK",
"H", "HU", "AUS", "AU", "MEX", "MX", "N", "NO", "A", "AT",
"I", "IT", "UK", "GB", "BE", "BE", "CH", "CH", "TR", "TR",
"E", "ES", "RCH", "CL", "SF", "FI", "GH", "GH", "RA", "AR",
"DDR", "DE", "NIC", "NI", "HUN", "HU", "ZW", "ZW", "TZ", "TZ",
"KE", "KE", "NIRL", "GB", "RB", "BW", "INT", NA_character_, "AUT", "AT",
"NZ", "NZ", "BG", "BG", "ENG", "GB", "AT", "AT", "EC", "EC",
"P", "PT", "FI", "FI", "FO", "FO", "NO", "NO", "SE", "SE",
"GL", "GL", "EST", "EE", "GRL", "GL", "ZA", "ZA", "WAL", "GB",
"IT", "IT", "EN", "GB", "PL", "PL", "EAU", "UG", "GRN", "GD",
"EUS", "ES"
)
# 2. Update Tonder_grouped with the new ISO-ALPHA-2 codes
Tonder_grouped_clean <- Tonder_grouped %>%
# Join our lookup table
left_join(country_mapping, by = c("Nationalitet" = "old_code")) %>%
# Replace the old column with the new ISO codes
mutate(Nationalitet = iso_2) %>%
# Drop the extra lookup column
select(-iso_2) %>%
# Remove rows that evaluated to NA (like "INT") if you don't want them plotted
drop_na(Nationalitet)
# Now with Regions of "Atlantic", "Nordic", "DK" and "Other"
Tonder_grouped_clean1 <- Tonder_grouped1 %>%
# Join our lookup table
left_join(country_mapping, by = c("Nationalitet" = "old_code")) %>%
# Replace the old column with the new ISO codes
mutate(Nationalitet = iso_2) %>%
# Drop the extra lookup column
select(-iso_2) %>%
# Remove rows that evaluated to NA (like "INT") if you don't want them plotted
drop_na(Nationalitet)
# Now with Regions of "Atlantic", "DK" and "Other"
Tonder_grouped_clean2 <- Tonder_grouped2 %>%
# Join our lookup table
left_join(country_mapping, by = c("Nationalitet" = "old_code")) %>%
# Replace the old column with the new ISO codes
mutate(Nationalitet = iso_2) %>%
# Drop the extra lookup column
select(-iso_2) %>%
# Remove rows that evaluated to NA (like "INT") if you don't want them plotted
drop_na(Nationalitet)
# 3. Now merge with your long_lat dataset
# (Ensure you've run: colnames(long_lat)[3] <- "Nationalitet" first as per your script)
Tonder_long_lat <- merge(Tonder_grouped_clean, long_lat, by = "Nationalitet") %>%
arrange(År)
Tonder_long_lat1 <- merge(Tonder_grouped_clean1, long_lat, by = "Nationalitet") %>%
arrange(År)
Tonder_long_lat2 <- merge(Tonder_grouped_clean2, long_lat, by = "Nationalitet") %>%
arrange(År)
# Plot Again
anim3 <- ggplot(Tonder_long_lat, aes(Longitude, Latitude, size = n, label = rownames(Nationalitet))) +
geom_text(aes(color=All_Regions)) +
transition_time(År)+
labs(title = "{round({frame_time})}", x = "Longitude", y = "Latitude", color = "Region", size = "Number of\nartists at\nTønder Festival")+
theme(text = element_text(size=16))
animate(anim3 + transition_time(År), fps = 5)
